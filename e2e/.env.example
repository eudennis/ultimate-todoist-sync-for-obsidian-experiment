# Copy to e2e/.env (gitignored).

# API token of a DEDICATED, throwaway Todoist account (Settings → Integrations → Developer).
TODOIST_E2E_TOKEN=
# Email of that account. The harness refuses to run if the token belongs to anyone else.
TODOIST_E2E_EXPECTED_EMAIL=

# Optional: Obsidian version under test (downloaded into e2e/.cache). Defaults to the newest
# obsidian-X.Y.Z.asar found in e2e/.cache, then in ~/.config/obsidian (copied, never modified).
# E2E_OBSIDIAN_VERSION=1.13.7
# E2E_OBSIDIAN_ASAR=/path/to/obsidian-1.13.7.asar
# E2E_OBSIDIAN_BIN=/opt/Obsidian/obsidian

# Optional: run the Todoist Pro tests (task duration, deadlines). Needs the account on a Pro plan.
# E2E_PREMIUM=1

# Optional knobs
# E2E_SKIP_BUILD=1          # use the existing main.js instead of rebuilding
# E2E_KEEP_WORK=1           # keep per-test vaults in e2e/.work even when tests pass
# E2E_RETRIES=0
# E2E_HISTORY_FILE=/var/lib/asts-e2e/history.csv
