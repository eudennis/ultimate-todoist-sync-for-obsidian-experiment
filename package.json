{
	"name": "simple-todoist-sync",
	"version": "0.8.4",
	"description": "Sync tasks with Todoist.",
	"main": "main.js",
	"scripts": {
		"dev": "node npm_scripts/esbuild.config.mjs",
		"build": "npx tsc -noEmit -skipLibCheck && node npm_scripts/esbuild.config.mjs production && node npm_scripts/bump-patch.mjs",
		"build-without-tsc": "node npm_scripts/esbuild.config.mjs production",
		"build-local": "npx tsc -noEmit -skipLibCheck && node npm_scripts/esbuild.config.mjs production && node npm_scripts/build-local.mjs",
		"test": "vitest run",
		"test:watch": "vitest",
		"test:coverage": "vitest run --coverage",
		"lint": "eslint .",
		"version": "node npm_scripts/version-bump.mjs && git add manifest.json versions.json"
	},
	"keywords": [],
	"author": "",
	"license": "GNU GPLv3",
	"devDependencies": {
		"@eslint/js": "^9.39.4",
		"@types/node": "^22.19.19",
		"@typescript-eslint/eslint-plugin": "^8.60.1",
		"@typescript-eslint/parser": "^8.60.1",
		"@vitest/coverage-v8": "^4.1.8",
		"esbuild": "^0.28.0",
		"eslint": "^9.39.5",
		"eslint-plugin-obsidianmd": "^0.4.1",
		"obsidian": "latest",
		"tslib": "^2.8.1",
		"typescript": "~5.7",
		"typescript-eslint": "^8.67.0",
		"vitest": "^4.1.8"
	}
}
